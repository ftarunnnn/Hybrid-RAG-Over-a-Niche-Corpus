# Application Settings
APP_NAME="Hybrid RAG Networking Assistant"
APP_VERSION="1.0.0"
DEBUG=false

# Qdrant Vector Database
# Options: ":memory:", "qdrant_storage", or remote "http://qdrant:6333" (Docker) / "http://localhost:6333"
QDRANT_LOCATION="qdrant_storage"
QDRANT_COLLECTION="networking_corpus"
VECTOR_DIM=384

# BM25 Keyword Search
BM25_INDEX_PATH="data/bm25_index.pkl"
BM25_K1=1.5
BM25_B=0.75

# Hybrid Fusion & RRF Settings
RRF_K=60
VECTOR_WEIGHT=1.0
BM25_WEIGHT=1.0
TOP_K_CANDIDATES=20
TOP_K_FINAL=5

# Context Window Budget
MAX_CONTEXT_TOKENS=2500

# LLM Generation Provider
# Options: "auto", "ollama", "openai", "hosted"
LLM_PROVIDER="auto"
LLM_MODEL="llama3:latest"
LLM_BASE_URL="http://localhost:11434"
OPENAI_API_KEY=""
